<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_module_dependency_install_confirm_form" model="ir.ui.view">
        <field name="name">module.dependency.install.confirm.form</field>
        <field name="model">module.dependency.install.confirm</field>
        <field name="arch" type="xml">
            <form string="Module Dependency Confirmation">
                <div class="alert alert-info oe_button_box" role="alert">
                    <p class="mt-3">
                        <field name="message" nolabel="1" readonly="1"/>
                    </p>
                </div>
                <field name="operation" invisible="1"/>
                <field name="has_transitive_dependency_ids" invisible="1"/>

                <h3>Selected Modules</h3>
                <field
                    name="module_ids"
                    mode="kanban"
                    class="o_modules_field"
                    nolabel="1"
                    readonly="1"
                >
                    <kanban create="false" class="o_modules_kanban">
                        <field name="state"/>
                        <templates>
                            <t t-name="card" class="flex-row align-items-center">
                                <aside>
                                    <field name="icon" widget="image_url" options="{'size': [50, 50]}" alt="Icon"/>
                                </aside>
                                <main t-att-title="record.shortdesc.value">
                                    <field class="fw-bold fs-5 mb-0" name="shortdesc"/>
                                    <p class="text-muted small my-1 lh-sm">
                                        <field groups="!base.group_no_one" name="summary"/>
                                        <code groups="base.group_no_one">
                                            <field name="name"/>
                                        </code>
                                    </p>
                                </main>
                            </t>
                        </templates>
                    </kanban>
                </field>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <h3>Required Modules</h3>
                    <div class="d-flex align-items-center" invisible="not has_transitive_dependency_ids">
                        <field name="show_full_dependency_chain" nolabel="1"/>
                        <label
                            for="show_full_dependency_chain"
                            string="Show full dependency chain"
                            class="ms-2 mb-0"
                        />
                    </div>
                </div>
                <field
                    name="dependency_ids"
                    mode="kanban"
                    class="o_modules_field"
                    nolabel="1"
                    readonly="1"
                >
                    <kanban create="false" class="o_modules_kanban">
                        <field name="state"/>
                        <templates>
                            <t t-name="card" class="flex-row align-items-center">
                                <aside>
                                    <field name="icon" widget="image_url" options="{'size': [50, 50]}" alt="Icon"/>
                                </aside>
                                <main t-att-title="record.shortdesc.value">
                                    <field class="fw-bold fs-5 mb-0" name="shortdesc"/>
                                    <p class="text-muted small my-1 lh-sm">
                                        <field groups="!base.group_no_one" name="summary"/>
                                        <code groups="base.group_no_one">
                                            <field name="name"/>
                                        </code>
                                    </p>
                                </main>
                            </t>
                        </templates>
                    </kanban>
                </field>

                <div invisible="not show_full_dependency_chain or not has_transitive_dependency_ids">
                    <h3>Also Installed Through Dependencies</h3>
                    <field
                        name="transitive_dependency_ids"
                        mode="kanban"
                        class="o_modules_field"
                        nolabel="1"
                        readonly="1"
                    >
                        <kanban create="false" class="o_modules_kanban">
                            <field name="state"/>
                            <templates>
                                <t t-name="card" class="flex-row align-items-center">
                                    <aside>
                                        <field name="icon" widget="image_url" options="{'size': [50, 50]}" alt="Icon"/>
                                    </aside>
                                    <main t-att-title="record.shortdesc.value">
                                        <field class="fw-bold fs-5 mb-0" name="shortdesc"/>
                                        <p class="text-muted small my-1 lh-sm">
                                            <field groups="!base.group_no_one" name="summary"/>
                                            <code groups="base.group_no_one">
                                                <field name="name"/>
                                            </code>
                                        </p>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </div>

                <footer>
                    <button
                        name="action_continue"
                        type="object"
                        string="Continue"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>